data/*.zip
# The full NicheNet tables are large and released externally.
data/gene_sets/nichenet_*.csv

# ---- released model weights (hosted externally) ----
checkpoints/*/

# ---- run outputs ----
outputs/
release/

# ---- python / env cruft ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store
